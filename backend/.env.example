# INOVEX Backend Environment Configuration

# MySQL Connection (Set your MySQL credentials here)
# Format: mysql+pymysql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/inovex_db

# Or use individual MySQL variables:
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=inovex_db

# Security
SECRET_KEY=inovex-super-secret-jwt-key-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI (Optional - platform works with smart built-in heuristics if empty)
GEMINI_API_KEY=
